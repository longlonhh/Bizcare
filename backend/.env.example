# ===== Database: MongoDB Atlas =====
# Vào Atlas > Cluster > Connect > Drivers để lấy chuỗi kết nối.
# Thay <password> bằng mật khẩu user database, thêm tên database trước dấu "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bizcare?retryWrites=true&w=majority

# ===== JWT =====
# QUAN TRỌNG: production BẮT BUỘC đặt JWT_SECRET riêng, tối thiểu 32 ký tự ngẫu nhiên.
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=bizcare-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ===== OTP SMS (Twilio/SpeedSMS/Zalo ZNS) =====
SMS_PROVIDER=speedsms
SMS_API_KEY=your_sms_api_key
SMS_SECRET=your_sms_secret

# ===== VietQR (mã QR thanh toán theo chuẩn NAPAS 247) =====
VIETQR_BANK_BIN=970436
VIETQR_BANK_ACCOUNT=YOUR_BANK_ACCOUNT
VIETQR_BANK_NAME=Vietcombank

# ===== Frontend =====
FRONTEND_URL=http://localhost:5173

# ===== App =====
PORT=3000
NODE_ENV=development
